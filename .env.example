# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# GUARDRAIL_MODEL=claude-haiku-5-5
# LOG_FORMAT=text              # json (default) for production, text for local reading
# TRUSTED_PROXY_HOPS=1          # 0 when running without a reverse proxy
# SNOWFLAKE_POOL_SIZE=4

# --- Snowflake (see scripts/snowflake_setup.sql) ---
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=CENSUS_APP
# Key-pair auth (preferred). Either a path or the PEM contents (newlines as \n).
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PEM=
# SNOWFLAKE_PASSWORD=          # fallback if no key is set
SNOWFLAKE_ROLE=CENSUS_READER
SNOWFLAKE_WAREHOUSE=CENSUS_WH
SNOWFLAKE_DATABASE=US_OPEN_CENSUS_DATA_NEIGHBORHOOD_INSIGHTS_FREE_DATASET
SNOWFLAKE_SCHEMA=PUBLIC
CENSUS_YEARS=2019,2020

# --- Web ---
BASIC_AUTH_USER=reviewer
BASIC_AUTH_PASSWORD=change-me
